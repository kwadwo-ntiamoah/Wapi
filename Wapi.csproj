<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Package Information -->
    <PackageId>DevJojo.WApi</PackageId>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Authors>DevJojo</Authors>
    <Company>DevJojo</Company>
    <Description>A comprehensive .NET library for WhatsApp Business API integration, providing easy-to-use methods for sending and receiving messages, handling media, and managing WhatsApp interactions.</Description>
    <PackageTags>whatsapp;api;business;messaging;chat;meta;facebook</PackageTags>
    <RepositoryUrl>https://github.com/kwadwo-ntiamoah/Wapi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kwadwo-ntiamoah/Wapi</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v2.0.0: BREAKING - DecodeInboundMessage now returns ErrorOr&lt;InboundResult&gt; instead of a (waId, displayName, BaseMessage) tuple, to support business-scoped user IDs (contacts with no visible phone number). Added Contact.UserId, Profile.Username, BaseMessage.FromUserId, and IWApi.RequestContactInfo for prompting cold contacts to share their number. v1.0.2: Added graceful handling for inbound message status updates (delivered/read/etc) via MessageStatus without throwing errors; improved webhook decoding robustness.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="ErrorOr" Version="2.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
